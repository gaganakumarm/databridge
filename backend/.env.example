DATABRIDGE_ENVIRONMENT=development
DATABRIDGE_LOG_LEVEL=INFO
DATABRIDGE_LOG_DIRECTORY=logs
DATABRIDGE_LOG_MAX_BYTES=1048576
DATABRIDGE_LOG_BACKUP_COUNT=3
# Set false for stdout-only deployments.
DATABRIDGE_LOG_TO_FILE=true
# Optional for health-only startup; required for persistence and migrations.
# Replace placeholder; never commit your real database URL.
# DATABRIDGE_DATABASE_URL=postgresql+psycopg://databridge:CHANGE_ME@127.0.0.1:5432/databridge
# Tests require a separate disposable database with a name ending in _test.
# Set DATABRIDGE_TEST_DATABASE_URL in your shell, not this file.
